{
  "name": "maalam-android",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Maalam \u2014 Darija AI tutor. Single Vite/React build wrapped with Capacitor 8 for Android. No CDN at runtime.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:report": "vite build --mode report",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "apk:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "apk:release": "npm run cap:sync && cd android && ./gradlew assembleRelease",
    "aab:release": "npm run cap:sync && cd android && ./gradlew bundleRelease",
    "assets:fetch": "node scripts/fetch-assets.mjs",
    "reference": "node reference/capture.mjs",
    "verify:offline": "node scripts/verify-no-cdn.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@fontsource/kalam": "5.3.0",
    "@fontsource/patrick-hand": "5.3.0",
    "@fontsource/playpen-sans": "5.3.0",
    "@fontsource/playpen-sans-arabic": "5.3.0",
    "@fontsource/sora": "5.3.0",
    "@google/genai": "^2.26.0",
    "clsx": "2.1.1",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "katex": "^0.19.0",
    "lucide-react": "^1.50.0",
    "pdfjs-dist": "^5.6.205",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/cli": "8.5.3",
    "@tailwindcss/vite": "4.1.17",
    "@types/katex": "^0.16.8",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "playwright": "^1.56.0",
    "rollup-plugin-visualizer": "^6.0.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2"
  }
}
